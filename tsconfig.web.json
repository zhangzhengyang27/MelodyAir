{
  "compilerOptions": {
    "composite": true,
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "outDir": "./out",
    "jsx": "preserve",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/renderer/src/*"]
    }
  },
  // src/env.d.ts 提供 vite/client 的 import.meta.env 等全局类型，
  // 不在 renderer/src 下，必须显式包含，否则所有 import.meta.env 报 TS2339
  "include": ["src/env.d.ts", "src/renderer/src/**/*", "src/renderer/src/**/*.vue"]
}
